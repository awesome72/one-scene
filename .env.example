# Anthropic
ANTHROPIC_API_KEY=
MODEL_QUESTIONER=claude-sonnet-5-5
MODEL_ASSEMBLER=claude-sonnet-5-5
MODEL_FIDELITY=claude-sonnet-5-5
MODEL_EXTRACTOR=claude-haiku-4-5-20251001
MODEL_REVIEWER=claude-haiku-4-5-20251001

# DB
DATABASE_URL=sqlite:///./one_scene.db

# 음성 (Phase 5): OpenAI 받아쓰기·읽어 주기. 비우면 브라우저 내장 음성으로 대비
OPENAI_API_KEY=
MODEL_STT=gpt-4o-mini-transcribe
MODEL_TTS=gpt-4o-mini-tts
TTS_VOICE=marin

# 로그인 (운영은 Vercel의 Neon 연결이 넣어 준다. 비우면 로컬은 X-User-Id)
NEON_AUTH_BASE_URL=

# 로그인 없이 공개하는 동안의 하루 AI 작업 상한 (0이면 끔)
DAILY_LLM_LIMIT=300
DAILY_LLM_LIMIT_PER_USER=60
DAILY_VOICE_LIMIT_PER_USER=200
# 사후 LLM 검수(기록용) 표본 비율
REVIEW_SAMPLE_RATE=0.1
